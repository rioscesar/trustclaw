# TrustClaw uses these only for the OpenClaw email demo. Never commit real
# values here; copy this file to `.env` (already gitignored) and fill it in
# locally, or export the variables in your shell before starting OpenClaw.

# "simulated" (default, no network) or "real" (sends through SMTP).
TRUSTCLAW_EMAIL_MODE=simulated

# Required only when TRUSTCLAW_EMAIL_MODE=real. Any standard SMTP submission
# endpoint works (Gmail, Outlook/Microsoft 365, Fastmail, a transactional
# provider's SMTP relay, etc.) as long as it accepts STARTTLS/TLS.
TRUSTCLAW_SMTP_HOST=
TRUSTCLAW_SMTP_PORT=587
TRUSTCLAW_SMTP_SECURE=false
TRUSTCLAW_SMTP_USER=
TRUSTCLAW_SMTP_PASS=
TRUSTCLAW_SMTP_FROM=
