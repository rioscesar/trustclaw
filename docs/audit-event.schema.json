{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustclaw.dev/schemas/audit-event.schema.json",
  "title": "TrustClaw Audit Event",
  "description": "A versioned event in a tamper-evident audit chain. Metadata must be redacted and contain no sensitive raw tool arguments.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "eventType",
    "timestamp",
    "requestId",
    "metadata",
    "previousDigest",
    "digest"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "eventId": { "type": "string", "minLength": 1 },
    "eventType": {
      "type": "string",
      "enum": ["request", "policy_decision", "approval", "execution", "outcome"]
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "requestId": { "type": "string", "minLength": 1 },
    "metadata": {
      "type": "object",
      "description": "Redacted, non-sensitive metadata only.",
      "additionalProperties": true
    },
    "previousDigest": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
